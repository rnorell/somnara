# Supabase — get these from https://supabase.com/dashboard → Project Settings → API
# Copy this file to .env and fill in your values.
# The app fails closed until these public client configuration values are set.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Sentry — get this from https://sentry.io → Project Settings → Client Keys (DSN)
# Optional: crash reporting stays off until this is set.
EXPO_PUBLIC_SENTRY_DSN=

# Dev-only: skip device claiming/onboarding and fake the BLE link to preview the UI without hardware.
# EXPO_PUBLIC_DEMO_DEVICE=true
# EXPO_PUBLIC_BLE_DRIVER=mock
